<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>WildPulse Experiences</title>
<meta name="description" content="Curated wildlife safaris in Tadoba, Melghat, Pench and Kanha. Handpicked stays and seamless trip planning from Amravati, Maharashtra.">
<meta property="og:title" content="WildPulse Experiences">
<meta property="og:description" content="Curated wildlife safaris in Tadoba, Melghat, Pench and Kanha. Plan your trip on WhatsApp: +91 86689 43343.">
<meta property="og:image" content="https://surajraut8136-spec.github.io/wildpulse/preview.jpg">
<meta property="og:url" content="https://surajraut8136-spec.github.io/wildpulse/">
<meta property="og:type" content="website">
<meta name="theme-color" content="#26381c">
<link rel="icon" href="data:image/png;base64,">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800;900&family=Figtree:wght@400;500;600;700&family=Kaushan+Script&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
/* Layout: field-journal — full-bleed photo plates alternate with forest-green bands; content on a 1160px column. */
:root{
  --bg:#f5f1e4;            /* parchment */
  --surface:#ebe5d0;
  --ink:#1d2a17;           /* forest ink */
  --muted:#5b6650;
  --forest:#26381c;
  --forest-2:#33492a;
  --gold:#b48a1e;
  --gold-soft:#d9b44a;
  --line:rgba(38,56,28,.18);
  --on-forest:#f1ead2;
  --card:#fbf8ee;
  --f-display:"Big Shoulders Display","Oswald","Arial Narrow",Impact,sans-serif;
  --f-body:"Figtree","Segoe UI",system-ui,sans-serif;
  --f-script:"Kaushan Script","Brush Script MT",cursive;
  --f-mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#11180d;--surface:#18220f;--ink:#ece5cc;--muted:#a7ab92;--forest:#1b2713;--forest-2:#24331a;
  --gold:#d9b44a;--gold-soft:#e7c768;--line:rgba(236,229,204,.14);--on-forest:#f1ead2;--card:#172010;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#11180d;--surface:#18220f;--ink:#ece5cc;--muted:#a7ab92;--forest:#1b2713;--forest-2:#24331a;
  --gold:#d9b44a;--gold-soft:#e7c768;--line:rgba(236,229,204,.14);--on-forest:#f1ead2;--card:#172010;color-scheme:dark}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:1rem;line-height:1.6;-webkit-font-smoothing:antialiased}
.wrap{max-width:1160px;margin-inline:auto;padding-inline:clamp(16px,4vw,32px)}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;margin:0;line-height:.95;letter-spacing:.01em;text-transform:uppercase}
h2{font-size:clamp(2.4rem,6vw,4.2rem);font-weight:900}
h3{font-size:1.6rem;font-weight:800}
p{margin:0}
a{color:inherit}
.eyebrow{font-family:var(--f-mono);font-size:.74rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.script{font-family:var(--f-script);color:var(--gold);text-transform:none;font-weight:400;letter-spacing:0}
.lede{font-size:1.12rem;color:var(--muted);max-width:62ch}
section{padding-block:clamp(56px,9vw,104px)}
.sec-head{display:grid;gap:12px;margin-bottom:clamp(28px,4vw,44px);max-width:760px}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px;border-radius:4px}

/* nav */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:40;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;height:62px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none}
.brand img{width:40px;height:40px}
.brand b{font-family:var(--f-display);font-weight:900;font-size:1.35rem;letter-spacing:.03em}
.brand b span{color:var(--gold)}
.nav-links{display:flex;gap:22px;font-size:.92rem;font-weight:600}
.nav-links a{text-decoration:none;color:var(--muted)}
.nav-links a:hover{color:var(--ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:600 .95rem/1 var(--f-body);padding:13px 20px;border-radius:999px;border:1.5px solid transparent;cursor:pointer;text-decoration:none;transition:transform .15s,background .15s}
.btn:hover{transform:translateY(-1px)}
.btn-gold{background:var(--gold);color:#1a1f10}
.btn-gold:hover{background:var(--gold-soft)}
.btn-ghost{border-color:currentColor;background:transparent}
.btn-sm{padding:10px 16px;font-size:.88rem}
@media (max-width:820px){.nav-links{display:none}}

/* hero */
.hero{position:relative;color:#f4eedb;background:#0e140a;overflow:hidden}
.hero img.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:62% 30%;opacity:.88}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,15,7,.92) 0%,rgba(10,15,7,.6) 42%,rgba(10,15,7,.05) 75%),linear-gradient(0deg,rgba(10,15,7,.7),transparent 40%)}
.hero .wrap{position:relative;z-index:1;padding-block:clamp(72px,12vw,140px) clamp(40px,6vw,64px);display:grid;gap:22px}
.hero .script{font-size:clamp(1.6rem,3.5vw,2.4rem);color:var(--gold-soft)}
.hero h1{font-size:clamp(3.6rem,11vw,8.4rem);font-weight:900;line-height:.86;max-width:9ch}
.hero h1 em{font-style:normal;color:var(--gold-soft);display:block;font-size:.52em;letter-spacing:.06em;margin-top:.15em}
.hero p.lede{color:#d9d3bd;max-width:46ch}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
.hero .ctas .btn-ghost{color:#f4eedb}
.hero-meta{display:flex;flex-wrap:wrap;gap:10px 28px;margin-top:clamp(28px,5vw,56px);padding-top:18px;border-top:1px solid rgba(244,238,219,.2);font-family:var(--f-mono);font-size:.78rem;letter-spacing:.06em;color:#cfc8ae}
.hero-meta b{color:#f4eedb;font-weight:500}
.hero-anim>*{animation:rise .8s cubic-bezier(.2,.7,.2,1) both}
.hero-anim>*:nth-child(2){animation-delay:.08s}.hero-anim>*:nth-child(3){animation-delay:.16s}.hero-anim>*:nth-child(4){animation-delay:.24s}.hero-anim>*:nth-child(5){animation-delay:.32s}
@keyframes rise{from{transform:translateY(14px)}to{transform:none}}

/* about */
.about-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(28px,5vw,64px);align-items:start}
.about-grid>*{min-width:0}
.about-copy{display:grid;gap:18px;font-size:1.06rem;max-width:62ch}
.about-copy p+p{color:var(--muted)}
.creds{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:10px}
.creds div{background:var(--bg);padding:18px 16px}
.creds b{display:block;font-family:var(--f-display);font-size:2.6rem;font-weight:900;line-height:1;color:var(--gold)}
.creds span{font-size:.85rem;color:var(--muted)}
.about-photo{position:relative}
.about-photo img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:6px;display:block}
.about-photo figcaption{font-family:var(--f-mono);font-size:.72rem;color:var(--muted);margin-top:8px;letter-spacing:.04em}
@media (max-width:820px){.about-grid{grid-template-columns:1fr}.about-photo img{aspect-ratio:4/3}}
@media (max-width:440px){.creds{grid-template-columns:1fr}}

/* traveller finder */
.band{background:var(--forest);color:var(--on-forest)}
.band .lede{color:color-mix(in srgb,var(--on-forest) 72%,transparent)}
.band .eyebrow{color:var(--gold-soft)}
.persona-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.persona-tabs button{all:unset;cursor:pointer;display:grid;gap:10px;padding:18px;border-radius:12px;border:1.5px solid rgba(241,234,210,.18);transition:border-color .15s,background .15s}
.persona-tabs button:hover{border-color:rgba(241,234,210,.45)}
.persona-tabs button[aria-selected="true"]{background:var(--forest-2);border-color:var(--gold-soft)}
.persona-tabs button:focus-visible{outline:2px solid var(--gold-soft);outline-offset:2px}
.persona-tabs svg{width:30px;height:30px;stroke:var(--gold-soft);fill:none;stroke-width:1.6}
.persona-tabs b{font-family:var(--f-display);font-size:1.3rem;font-weight:800;text-transform:uppercase;line-height:1}
.persona-tabs small{font-size:.8rem;opacity:.7}
.persona-panel{margin-top:18px;display:grid;grid-template-columns:1.3fr 1fr;gap:24px;padding:clamp(20px,3vw,32px);border-radius:14px;background:var(--forest-2)}
.persona-panel>*{min-width:0}
.persona-panel h3{color:var(--on-forest);margin-bottom:10px}
.persona-panel ul{margin:12px 0 0;padding:0;list-style:none;display:grid;gap:8px}
.persona-panel li{padding-left:22px;position:relative}
.persona-panel li::before{content:"";position:absolute;left:0;top:.65em;width:10px;height:2px;background:var(--gold-soft)}
.persona-rec{border-left:1px solid rgba(241,234,210,.18);padding-left:24px;display:grid;gap:10px;align-content:start}
.persona-rec .eyebrow{color:var(--gold-soft)}
.persona-rec b{font-family:var(--f-display);font-size:1.8rem;font-weight:800;text-transform:uppercase;line-height:1}
@media (max-width:820px){.persona-tabs{grid-template-columns:repeat(2,1fr)}.persona-panel{grid-template-columns:1fr}.persona-rec{border-left:0;border-top:1px solid rgba(241,234,210,.18);padding:18px 0 0}}

/* destinations */
.dest-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.chip{all:unset;cursor:pointer;font:600 .9rem/1 var(--f-body);padding:11px 16px;border-radius:999px;border:1.5px solid var(--line);color:var(--muted)}
.chip:hover{color:var(--ink);border-color:var(--muted)}
.chip[aria-selected="true"],.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.chip:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.dest{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--card)}
.dest>*{min-width:0}
.dest-map{background:var(--surface);position:relative;padding:20px;display:grid;align-content:space-between;gap:16px;min-height:340px}
.dest-map svg{width:100%;height:auto;display:block}
.dest-body{padding:clamp(22px,3vw,36px);display:grid;gap:16px;align-content:start}
.dest-body h3{font-size:clamp(2.2rem,4vw,3rem);font-weight:900}
.coords{font-family:var(--f-mono);font-size:.76rem;color:var(--muted);letter-spacing:.04em}
.facts{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 20px;padding-top:14px;border-top:1px solid var(--line)}
.facts dt{font-family:var(--f-mono);font-size:.68rem;text-transform:uppercase;letter-spacing:.12em;color:var(--gold)}
.facts dd{margin:3px 0 0;font-size:.94rem}
.species{display:flex;flex-wrap:wrap;gap:6px}
.species span{font-size:.8rem;padding:5px 10px;border-radius:999px;background:var(--surface);color:var(--ink)}
@media (max-width:820px){.dest{grid-template-columns:1fr}.dest-map{min-height:0}}

/* season */
.season{margin-top:clamp(36px,5vw,56px);display:grid;gap:14px}
.months{display:grid;grid-template-columns:repeat(12,1fr);gap:4px}
.months button{all:unset;cursor:pointer;text-align:center;padding:12px 0 10px;border-radius:8px;font-family:var(--f-mono);font-size:.74rem;display:grid;gap:8px;justify-items:center;color:var(--ink)}
.months button i{display:block;width:100%;height:8px;border-radius:4px}
.months button[aria-pressed="true"]{background:var(--surface);outline:1.5px solid var(--ink)}
.months button:focus-visible{outline:2px solid var(--gold)}
.m-cool i{background:#6f8f4a}.m-hot i{background:var(--gold)}.m-wet i{background:repeating-linear-gradient(45deg,var(--line) 0 4px,transparent 4px 8px);border:1px solid var(--line)}
.legend{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:.82rem;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:8px}
.legend i{width:18px;height:8px;border-radius:4px;display:inline-block}
.season-note{padding:16px 18px;border-radius:12px;background:var(--card);border:1px solid var(--line);font-size:.96rem;max-width:72ch}
.season-note b{font-family:var(--f-display);font-size:1.25rem;text-transform:uppercase;font-weight:800;margin-right:8px}
@media (max-width:560px){.months{grid-template-columns:repeat(6,1fr)}}

/* packages */
.pkg-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.pkgs{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px}
.pkg{display:grid;grid-template-rows:auto 1fr auto;border:1px solid var(--line);border-radius:16px;background:var(--card);overflow:hidden}
.pkg-top{padding:22px 22px 0;display:grid;gap:10px}
.pkg-meta{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-family:var(--f-mono);font-size:.74rem;color:var(--muted)}
.pkg-meta .dur{color:var(--gold);font-weight:500;letter-spacing:.06em}
.pkg h3{font-size:1.9rem;font-weight:900}
.pkg-body{padding:12px 22px 0;display:grid;gap:12px;align-content:start}
.pkg-body p{color:var(--muted);font-size:.95rem}
.pkg ul{list-style:none;margin:0;padding:0;display:grid;gap:6px;font-size:.92rem}
.pkg li{display:flex;gap:10px}
.pkg li svg{flex:none;width:16px;height:16px;margin-top:4px;stroke:var(--gold);fill:none;stroke-width:2.2}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{font-size:.74rem;font-weight:600;padding:4px 9px;border-radius:6px;background:var(--surface)}
.pkg details{border-top:1px dashed var(--line);padding-top:10px}
.pkg summary{cursor:pointer;font-weight:600;font-size:.9rem;list-style:none;display:flex;align-items:center;gap:8px}
.pkg summary::-webkit-details-marker{display:none}
.pkg summary::before{content:"+";font-family:var(--f-mono);color:var(--gold);width:14px}
.pkg details[open] summary::before{content:"–"}
.pkg ol{margin:10px 0 0;padding:0;list-style:none;display:grid;gap:8px;font-size:.88rem;color:var(--muted)}
.pkg ol b{color:var(--ink);font-family:var(--f-mono);font-size:.74rem;font-weight:500;display:block}
.pkg-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:18px 22px;margin-top:18px;border-top:1px solid var(--line)}
.pkg-foot small{font-family:var(--f-mono);font-size:.74rem;color:var(--muted)}
.pkg.custom{background:var(--forest);color:var(--on-forest);border-color:transparent}
.pkg.custom .pkg-body p,.pkg.custom .pkg-meta{color:color-mix(in srgb,var(--on-forest) 72%,transparent)}
.pkg.custom .pkg-foot{border-color:rgba(241,234,210,.18)}
.pkg.custom .pkg-foot small{color:color-mix(in srgb,var(--on-forest) 72%,transparent)}
.empty{padding:30px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:16px}

/* gallery */
.gallery{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:clamp(120px,16vw,190px);gap:10px}
.gallery button{all:unset;cursor:zoom-in;position:relative;overflow:hidden;border-radius:6px;background:var(--surface)}
.gallery button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.gallery img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.gallery button:hover img{transform:scale(1.04)}
.gallery figcaption{position:absolute;left:0;right:0;bottom:0;padding:24px 12px 10px;background:linear-gradient(transparent,rgba(8,12,6,.75));color:#f4eedb;font-size:.82rem;font-weight:600}
.g1{grid-column:span 4;grid-row:span 2}.g2{grid-column:span 2;grid-row:span 2}.g3{grid-column:span 3;grid-row:span 2}.g4{grid-column:span 3;grid-row:span 2}
@media (max-width:640px){.gallery{grid-template-columns:repeat(2,1fr);grid-auto-rows:150px}.g1{grid-column:span 2;grid-row:span 2}.g2,.g3,.g4{grid-column:span 1;grid-row:span 2}.g4{grid-column:span 2}}
.lightbox{position:fixed;inset:0;z-index:100;background:rgba(6,9,4,.94);display:grid;place-items:center;padding:calc(env(safe-area-inset-top,0px) + 56px) 16px calc(env(safe-area-inset-bottom,0px) + 72px)}
.lightbox img{max-height:100%;max-width:100%;object-fit:contain;border-radius:4px}
.lb-cap{position:absolute;left:16px;right:16px;bottom:calc(env(safe-area-inset-bottom,0px) + 24px);text-align:center;color:#e9e2c8;font-size:.92rem}
.lb-btn{position:absolute;background:rgba(244,238,219,.12);color:#f4eedb;border:0;width:44px;height:44px;border-radius:50%;cursor:pointer;font-size:1.3rem;display:grid;place-items:center}
.lb-btn:hover{background:rgba(244,238,219,.24)}
.lb-close{top:calc(env(safe-area-inset-top,0px) + 12px);right:12px}
.lb-prev{left:12px;top:50%;transform:translateY(-50%)}.lb-next{right:12px;top:50%;transform:translateY(-50%)}

/* journey */
.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0;counter-reset:s;border-top:2px solid var(--gold-soft)}
.steps li{list-style:none;padding:20px 18px 0 0;display:grid;gap:8px;position:relative}
.steps li::before{counter-increment:s;content:"0" counter(s);font-family:var(--f-mono);font-size:.78rem;color:var(--gold-soft)}
.steps li::after{content:"";position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:50%;background:var(--gold-soft)}
.steps b{font-family:var(--f-display);font-size:1.35rem;font-weight:800;text-transform:uppercase;line-height:1}
.steps span{font-size:.9rem;opacity:.75}
.steps{padding:0;margin:0}
@media (max-width:820px){.steps{grid-template-columns:1fr;border-top:0;border-left:2px solid var(--gold-soft);padding-left:22px;gap:22px}.steps li{padding:0}.steps li::after{top:4px;left:-29px}}
.promise{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:clamp(36px,5vw,56px)}
.promise div{display:flex;gap:10px;align-items:center;padding:14px 16px;border:1px solid rgba(241,234,210,.18);border-radius:10px;font-weight:600;font-size:.9rem}
.promise svg{flex:none;width:22px;height:22px;stroke:var(--gold-soft);fill:none;stroke-width:1.8}
@media (max-width:820px){.promise{grid-template-columns:repeat(2,1fr)}}

/* faq */
.faq{display:grid;gap:0;border-top:1px solid var(--line);max-width:860px}
.faq details{border-bottom:1px solid var(--line);padding:18px 0}
.faq summary{cursor:pointer;font-weight:600;font-size:1.05rem;list-style:none;display:flex;justify-content:space-between;gap:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-family:var(--f-mono);color:var(--gold);font-size:1.2rem;line-height:1}
.faq details[open] summary::after{content:"–"}
.faq p{margin-top:10px;color:var(--muted);max-width:68ch}

/* enquiry */
.enq{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(28px,5vw,56px);align-items:start}
.enq>*{min-width:0}
.enq-side{display:grid;gap:18px;position:sticky;top:calc(env(safe-area-inset-top,0px) + 84px)}
.contact-card{display:grid;gap:12px;padding:20px;border-radius:14px;background:var(--forest);color:var(--on-forest)}
.contact-row{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.contact-row .num{font-family:var(--f-display);font-size:2rem;font-weight:800;letter-spacing:.02em;user-select:all}
.contact-card small{opacity:.75}
.copy{all:unset;cursor:pointer;font:600 .8rem/1 var(--f-body);padding:9px 12px;border-radius:999px;border:1.5px solid rgba(241,234,210,.35)}
.copy:focus-visible{outline:2px solid var(--gold-soft)}
form.card{display:grid;gap:16px;padding:clamp(20px,3vw,32px);border:1px solid var(--line);border-radius:16px;background:var(--card)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.row>*{min-width:0}
@media (max-width:560px){.row{grid-template-columns:1fr}.enq{grid-template-columns:1fr}.enq-side{position:static}}
@media (max-width:860px){.enq{grid-template-columns:1fr}.enq-side{position:static}}
label{display:grid;gap:6px;font-size:.85rem;font-weight:600}
input,select,textarea{font:inherit;font-weight:400;font-size:.98rem;color:var(--ink);background:var(--bg);border:1.5px solid var(--line);border-radius:10px;padding:11px 12px;width:100%}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--gold)}
textarea{min-height:96px;resize:vertical}
fieldset{border:0;padding:0;margin:0;display:grid;gap:8px}
