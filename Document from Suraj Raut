const PKG_FILTERS=[["all","All"],["first","First-timers"],["family","Families"],["photo","Photography"],["nature","Slow & nature"],["adventure","Multi-park"]];
const PHOTOS=[
 {src:"data:image/jpeg;base64,",cap:"Tiger mid-yawn, resting in dry grass",cls:"g1"},
 {src:"data:image/jpeg;base64,",cap:"Indian peafowl on a termite mound",cls:"g2"},
 {src:"data:image/jpeg;base64,",cap:"Tiger watching from tall grass",cls:"g3"},
 {src:"data:image/jpeg;base64,",cap:"Indian roller perched on fresh leaves",cls:"g4"}
];

/* ---------- personas ---------- */
let persona="first";
function renderPersona(){
  $("#personaTabs").innerHTML=PERSONAS.map(p=>`<button role="tab" id="pt-${p.id}" aria-selected="${p.id===persona}" aria-controls="personaPanel" data-p="${p.id}"><svg viewBox="0 0 24 24" aria-hidden="true">${p.icon}</svg><b>${p.label}</b><small>${p.sub}</small></button>`).join("");
  const p=PERSONAS.find(x=>x.id===persona), pk=PKGS.find(x=>x.id===p.rec);
  $("#personaPanel").setAttribute("aria-labelledby","pt-"+p.id);
  $("#personaPanel").innerHTML=`<div><h3>${p.title}</h3><ul>${p.points.map(x=>`<li>${x}</li>`).join("")}</ul></div>
   <div class="persona-rec"><span class="eyebrow">We'd suggest</span><b>${pk.name}</b><span style="opacity:.8">${pk.dur} · ${p.why}</span>
   <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px"><button class="btn btn-gold btn-sm" type="button" data-enq="${pk.id}" data-type="${p.id}">Enquire about this</button><a class="btn btn-ghost btn-sm" href="#packages" style="color:var(--on-forest)">All packages</a></div></div>`;
}
$("#personaTabs").addEventListener("click",e=>{const b=e.target.closest("[data-p]");if(b){persona=b.dataset.p;renderPersona();$("#pt-"+persona).focus()}});
$("#personaTabs").addEventListener("keydown",e=>{if(!["ArrowRight","ArrowLeft"].includes(e.key))return;const i=PERSONAS.findIndex(p=>p.id===persona);persona=PERSONAS[(i+(e.key==="ArrowRight"?1:-1)+PERSONAS.length)%PERSONAS.length].id;renderPersona();$("#pt-"+persona).focus()});

/* ---------- destinations ---------- */
let dest="tadoba";
function mapSvg(active){
  const pins=DEST.map(d=>{const on=d.id===active;return `<g>${on?`<circle cx="${d.x}" cy="${d.y}" r="16" fill="var(--gold)" opacity=".22"/>`:""}<circle cx="${d.x}" cy="${d.y}" r="${on?7:5}" fill="${on?'var(--gold)':'var(--muted)'}"/><text x="${d.x+(d.id==='kanha'?-12:12)}" y="${d.y+4}" text-anchor="${d.id==='kanha'?'end':'start'}" font-family="JetBrains Mono,monospace" font-size="11" fill="${on?'var(--ink)':'var(--muted)'}" font-weight="${on?600:400}">${d.name.split('-')[0].toUpperCase()}</text></g>`}).join("");
  return `<svg viewBox="0 0 340 230" role="img" aria-label="Sketch map of the four forests in Vidarbha and Madhya Pradesh">
   <path d="M10 140 C60 120 90 150 130 135 S200 120 240 132 330 120 330 120" fill="none" stroke="var(--line)" stroke-width="1.2" stroke-dasharray="4 4"/>
   <text x="14" y="158" font-family="JetBrains Mono,monospace" font-size="9" fill="var(--muted)" letter-spacing="1">MAHARASHTRA ↓  ·  MADHYA PRADESH ↑</text>
   <circle cx="168" cy="138" r="3" fill="none" stroke="var(--ink)" stroke-width="1.4"/><text x="160" y="128" text-anchor="end" font-family="JetBrains Mono,monospace" font-size="9" fill="var(--muted)">NAGPUR</text>
   <circle cx="78" cy="150" r="3" fill="none" stroke="var(--ink)" stroke-width="1.4"/><text x="78" y="178" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="9" fill="var(--muted)">AMRAVATI · HQ</text>
   ${pins}
   <g transform="translate(312,196)"><path d="M0 -14 L5 0 L0 -3 L-5 0Z" fill="var(--ink)"/><text y="12" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="9" fill="var(--muted)">N</text></g>
  </svg>`;
}
function renderDest(){
  $("#destTabs").innerHTML=DEST.map(d=>`<button class="chip" role="tab" id="dt-${d.id}" aria-selected="${d.id===dest}" aria-controls="destPanel" data-d="${d.id}">${d.name}</button>`).join("");
  const d=DEST.find(x=>x.id===dest);
  const pk=PKGS.filter(p=>p.dest===d.id||p.dest2===d.id);
  $("#destPanel").setAttribute("aria-labelledby","dt-"+d.id);
  $("#destPanel").innerHTML=`<div class="dest-map">${mapSvg(d.id)}<span class="coords">Sketch map, not to scale · ${d.coord}</span></div>
   <div class="dest-body"><div style="display:grid;gap:6px"><span class="eyebrow">${d.state}</span><h3>${d.name}</h3></div><p>${d.blurb}</p>
   <dl class="facts">${d.facts.map(f=>`<div><dt>${f[0]}</dt><dd>${f[1]}</dd></div>`).join("")}</dl>
   <div style="display:grid;gap:8px"><span class="eyebrow">What you may see</span><div class="species">${d.species.map(s=>`<span>${s}</span>`).join("")}</div></div>
   <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">${pk.map(p=>`<button class="btn btn-ghost btn-sm" type="button" data-show="${p.id}">${p.name}</button>`).join("")}<button class="btn btn-gold btn-sm" type="button" data-enqdest="${d.id}">Enquire about ${d.name.split('-')[0]}</button></div></div>`;
}
$("#destTabs").addEventListener("click",e=>{const b=e.target.closest("[data-d]");if(b){dest=b.dataset.d;renderDest()}});

/* ---------- season ---------- */
let month=new Date().getMonth();
function renderSeason(){
  $("#months").innerHTML=MONTHS.map((m,i)=>`<button type="button" class="m-${m[1]}" aria-pressed="${i===month}" data-m="${i}">${m[0]}<i></i></button>`).join("");
  const m=MONTHS[month];
  $("#seasonNote").innerHTML=`<b>${m[0]}</b>${m[2]}`;
}
$("#months").addEventListener("click",e=>{const b=e.target.closest("[data-m]");if(b){month=+b.dataset.m;renderSeason()}});

/* ---------- packages ---------- */
let pf="all";
function renderPkgs(){
  $("#pkgFilters").innerHTML=PKG_FILTERS.map(f=>`<button class="chip" type="button" aria-pressed="${f[0]===pf}" data-f="${f[0]}">${f[1]}</button>`).join("");
  const list=PKGS.filter(p=>pf==="all"||p.style.includes(pf));
  const dn=id=>id==="any"?"Any forest":DEST.find(d=>d.id===id).name;
  $("#pkgs").innerHTML=list.map(p=>`<article class="pkg${p.custom?" custom":""}" id="pkg-${p.id}">
    <div class="pkg-top"><div class="pkg-meta"><span>${dn(p.dest)}${p.dest2?" + "+dn(p.dest2):""}</span><span class="dur">${p.dur}</span></div><h3>${p.name}</h3></div>
    <div class="pkg-body"><p>${p.desc}</p><ul>${p.inc.map(x=>`<li>${tick}<span>${x}</span></li>`).join("")}</ul>
     ${p.days.length?`<details><summary>Sample itinerary</summary><ol>${p.days.map(d=>`<li><b>${d[0]}</b>${d[1]}</li>`).join("")}</ol></details>`:""}</div>
    <div class="pkg-foot"><small>Price on request</small><button class="btn btn-gold btn-sm" type="button" data-enq="${p.id}">Enquire</button></div>
  </article>`).join("")||`<p class="empty">No packages match. Try "All".</p>`;
}
$("#pkgFilters").addEventListener("click",e=>{const b=e.target.closest("[data-f]");if(b){pf=b.dataset.f;renderPkgs()}});

/* ---------- gallery + lightbox ---------- */
let li=0;
$("#gallery").innerHTML=PHOTOS.map((p,i)=>`<button type="button" class="${p.cls}" data-i="${i}" aria-label="View photo: ${p.cap}"><img src="${p.src}" alt="${p.cap}" loading="lazy"><figcaption>${p.cap}</figcaption></button>`).join("");
let lastFocus=null;
function openLb(i){li=i;lastFocus=document.activeElement;showLb();$("#lb").hidden=false;document.body.style.overflow="hidden";$("#lbClose").focus()}
function showLb(){$("#lbImg").src=PHOTOS[li].src;$("#lbImg").alt=PHOTOS[li].cap;$("#lbCap").textContent=`${li+1} / ${PHOTOS.length} · ${PHOTOS[li].cap}`}
function closeLb(){$("#lb").hidden=true;document.body.style.overflow="";lastFocus&&lastFocus.focus()}
function step(d){li=(li+d+PHOTOS.length)%PHOTOS.length;showLb()}
$("#gallery").addEventListener("click",e=>{const b=e.target.closest("[data-i]");if(b)openLb(+b.dataset.i)});
$("#lbClose").onclick=closeLb;$("#lbPrev").onclick=()=>step(-1);$("#lbNext").onclick=()=>step(1);
$("#lb").addEventListener("click",e=>{if(e.target.id==="lb")closeLb()});
document.addEventListener("keydown",e=>{if($("#lb").hidden)return;if(e.key==="Escape")closeLb();if(e.key==="ArrowLeft")step(-1);if(e.key==="ArrowRight")step(1)});
let tx=null;$("#lb").addEventListener("touchstart",e=>{tx=e.touches[0].clientX},{passive:true});
$("#lb").addEventListener("touchend",e=>{if(tx===null)return;const dx=e.changedTouches[0].clientX-tx;if(Math.abs(dx)>40)step(dx<0?1:-1);tx=null});

/* ---------- enquiry ---------- */
const TYPES=[["first","First-time explorer"],["photo","Photographer"],["nature","Nature lover"],["adventure","Adventure seeker"],["family","Family / group"]];
const STAYS=[["Comfortable","Comfortable"],["Premium","Premium"],["Luxury","Luxury"],["Not sure","Not sure"]];
$("#fDest").innerHTML=`<option value="">Not sure yet, suggest one</option>`+DEST.map(d=>`<option value="${d.id}">${d.name}</option>`).join("");
$("#fPkg").innerHTML=`<option value="">No specific package</option>`+PKGS.map(p=>`<option value="${p.id}">${p.name} (${p.dur})</option>`).join("");
(function(){const now=new Date();let o=`<option value="">Flexible</option>`;for(let i=0;i<12;i++){const d=new Date(now.getFullYear(),now.getMonth()+i,1);const mi=d.getMonth();const lbl=d.toLocaleString("en-IN",{month:"long",year:"numeric"});o+=`<option value="${lbl}">${lbl}${MONTHS[mi][1]==="wet"?" (buffer zones only)":""}</option>`}$("#fMonth").innerHTML=o})();
$("#fType").innerHTML=TYPES.map(t=>`<label><input type="radio" name="type" id="ty-${t[0]}" value="${t[0]}"><span>${t[1]}</span></label>`).join("");
$("#fStay").innerHTML=STAYS.map((t,i)=>`<label><input type="radio" name="stay" id="st-${i}" value="${t[0]}"${i===0?" checked":""}><span>${t[1]}</span></label>`).join("");
let pax=2;
$("#tMinus").onclick=()=>{pax=Math.max(1,pax-1);$("#fPax").textContent=pax;update()};
$("#tPlus").onclick=()=>{pax=Math.min(40,pax+1);$("#fPax").textContent=pax;update()};

function buildMsg(){
  const f=$("#enqForm");const g=n=>(f.elements[n]&&f.elements[n].value||"").trim();
  const d=DEST.find(x=>x.id===g("dest")), p=PKGS.find(x=>x.id===g("pkg"));
  const t=TYPES.find(x=>x[0]===(f.querySelector('input[name=type]:checked')||{}).value);
  const lines=["Hi WildPulse! I'd like to plan a wildlife trip.",""];
  lines.push("Name: "+(g("name")||"—"));
  if(g("city"))lines.push("Travelling from: "+g("city"));
  lines.push("Forest: "+(d?d.name:"Open to suggestions"));
  if(p)lines.push("Package: "+p.name+" ("+p.dur+")");
  lines.push("When: "+(g("month")||"Flexible"));
  lines.push("Travellers: "+pax);
  if(t)lines.push("I am: "+t[1]);
  lines.push("Stay: "+((f.querySelector('input[name=stay]:checked')||{}).value||"Not sure"));
  if(g("msg"))lines.push("","Notes: "+g("msg"));
  return lines.join("\n");
}
function update(){
  const m=buildMsg();$("#preview").textContent=m;
  $("#waBtn").href="https://wa.me/"+PHONE+"?text="+encodeURIComponent(m);
  if($("#fName").value.trim())$("#err").hidden=true;
  try{const f=$("#enqForm"),E=f.elements;localStorage.setItem("wp-draft",JSON.stringify({name:E.name.value,city:E.city.value,dest:E.dest.value,pkg:E.pkg.value,month:E.month.value,msg:E.msg.value,pax,type:(f.querySelector('input[name=type]:checked')||{}).value||"",stay:(f.querySelector('input[name=stay]:checked')||{}).value||""}))}catch(e){}
}
$("#enqForm").addEventListener("input",update);
$("#enqForm").addEventListener("change",update);
$("#enqForm").addEventListener("submit",e=>e.preventDefault());
$("#fPkg").addEventListener("change",()=>{const p=PKGS.find(x=>x.id===$("#fPkg").value);if(p&&p.dest!=="any"){$("#fDest").value=p.dest;update()}});
$("#waBtn").addEventListener("click",e=>{if(!$("#fName").value.trim()){e.preventDefault();$("#err").hidden=false;$("#fName").focus()}});

async function copyText(text,btn,done){
  const orig=btn.textContent;
  try{await navigator.clipboard.writeText(text);btn.textContent=done}catch(err){
    const r=document.createRange();const node=btn.id==="copyPhone"?$("#phoneNum"):$("#preview");r.selectNodeContents(node);const s=getSelection();s.removeAllRanges();s.addRange(r);btn.textContent="Selected. Copy it now"}
  setTimeout(()=>btn.textContent=orig,2200);
}
$("#copyPhone").addEventListener("click",e=>copyText("+918668943343",e.currentTarget,"Copied"));
$("#copyMsg").addEventListener("click",e=>copyText(buildMsg(),e.currentTarget,"Message copied"));

/* jump-to-enquiry from anywhere */
function prefill({pkg,destId,type}){
  if(pkg){$("#fPkg").value=pkg;const p=PKGS.find(x=>x.id===pkg);if(p&&p.dest!=="any")$("#fDest").value=p.dest}
  if(destId)$("#fDest").value=destId;
  if(type){const r=$("#ty-"+type);if(r)r.checked=true}
  update();$("#enquire").scrollIntoView({behavior:matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth"});setTimeout(()=>$("#fName").focus({preventScroll:true}),500);
}
document.addEventListener("click",e=>{
  const b=e.target.closest("[data-enq],[data-enqdest],[data-show]");if(!b)return;
  if(b.dataset.show){pf="all";renderPkgs();const el=$("#pkg-"+b.dataset.show);el.scrollIntoView({behavior:"smooth",block:"center"});el.animate&&el.animate([{boxShadow:"0 0 0 3px var(--gold)"},{boxShadow:"0 0 0 0 transparent"}],{duration:1600});return}
  prefill({pkg:b.dataset.enq,destId:b.dataset.enqdest,type:b.dataset.type});
});

/* restore draft */
try{const s=JSON.parse(localStorage.getItem("wp-draft")||"null");if(s){const f=$("#enqForm");["name","city","dest","pkg","month","msg"].forEach(k=>{if(s[k]!=null)f.elements[k].value=s[k]});if(s.pax){pax=s.pax;$("#fPax").textContent=pax}if(s.type){const r=$("#ty-"+s.type);if(r)r.checked=true}if(s.stay){const r=f.querySelector(`input[name=stay][value="${s.stay}"]`);if(r)r.checked=true}}}catch(e){}

renderPersona();renderDest();renderSeason();renderPkgs();update();
})();
</script>

</body>
</html>
